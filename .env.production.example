# Production Environment Variables
# Copy this to .env.production and fill in the values

# Database
POSTGRES_DB=opendiscuss
POSTGRES_USER=opendiscuss
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD  # Generate with: openssl rand -base64 32

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD  # Generate with: openssl rand -base64 32

# API Keys (get from respective providers)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Backend URLs
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend
VITE_API_URL=https://api.yourdomain.com

# Security
JWT_SECRET=CHANGE_ME_JWT_SECRET  # Generate with: openssl rand -base64 64

# Environment
ENV=production
NODE_ENV=production

# Optional: Monitoring
SENTRY_DSN=
LOGROCKET_APP_ID=

# Optional: Analytics
GA_TRACKING_ID=
PLAUSIBLE_DOMAIN=
